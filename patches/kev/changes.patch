+    assert {parameter.dtype for name, parameter in reloaded.lm.named_parameters() if "trainable_tokens_delta" in name} == {torch.float32}
+    after = torch.cat(reloaded.probs(reloaded.encode(tok2, rec, strict=True)))
+    evidence["post_reload_probabilities"] = after.tolist()
+    (tmp_path / "e2b-round-trip.json").write_text(json.dumps(evidence, indent=2) + "\n")
+    torch.testing.assert_close(after, before, rtol=0, atol=g["atol"])
+    assert reloaded.execution_mode == "rows"
