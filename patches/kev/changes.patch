+import importlib.util
+import hashlib
+import json
+import re
+import sys
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+
+SCRIPT = Path(__file__).parents[1] / "scripts" / "base_mmlu_probe.py"
+
+
+def load_probe():
+    spec = importlib.util.spec_from_file_location("base_mmlu_probe", SCRIPT)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+class Batch(dict):
+    def to(self, device):
+        return self
+
+
+class FakeTokenizer:
+    def __init__(self):
+        self.prompts = []
+        self.messages = []
+
+    def encode(self, text, add_special_tokens=False):
+        letter = text.strip()
+        offset = 1 if text.startswith(" ") else 17
+        return [offset + ord(letter) - ord("A")]
+
+    def apply_chat_template(self, messages, **kwargs):
+        self.messages.append((messages, kwargs))
+        return "CHAT"
+
+    def __call__(self, prompt, **kwargs):
+        self.prompts.append((prompt, kwargs))
+        return Batch(input_ids=torch.tensor([[1, 2, 3]]))
+
+
+class FakeModel:
+    def __init__(self):
+        self.model = object()
+
+    def to(self, device):
+        return self
+
+    def eval(self):
+        return self
+
+    def __call__(self, **kwargs):
+        logits = torch.zeros((1, 1, 40))
+        for offset in (1, 17):
+            logits[0, 0, offset : offset + 16] = torch.arange(16, dtype=torch.float32)
+        return SimpleNamespace(logits=logits)
+
+
+def record(*, source="mmlu", variant="clean", record_id="r1"):
+    return {
+        "state": "Evidence text",
+        "questions": {
+            "decision": {
+                "type": "choice",
+                "instructions": "Choose one.",
+                "criteria": {"alpha": "First", "beta": "Second"},
+                "label": "beta",
+                "src": "topic",
+            }
+        },
+        "_meta": {
+            "id": record_id,
+            "group_id": record_id,
+            "source": source,
+            "variant": variant,
+        },
+    }
+
+
+def multi_question_record(*, source="custom", record_id="multi"):
+    return {
+        "state": {"message": "Evidence"},
+        "questions": {
+            "binary": {"type": "noul", "instructions": "Is this true?", "label": True},
+            "choice": {
+                "type": "choice",
+                "instructions": "Choose one.",
+                "criteria": {"a": "First", "b": "Second", "c": "Third"},
+                "label": "c",
+            },
+            "score": {
+                "type": "score",
+                "instructions": "Rate it.",
+                "criteria": ["Low", "High"],
+                "label": 1,
+            },
+        },
+        "_meta": {"source": source, "id": record_id, "group_id": record_id},
+    }
+
+
+def write_jsonl(path, records):
+    path.write_text("".join(json.dumps(item) + "\n" for item in records))
+
+
+def run_probe(monkeypatch, capsys, tmp_path, records, *arguments):
+    probe = load_probe()
+    tokenizer = FakeTokenizer()
+    model = FakeModel()
+    monkeypatch.setattr(probe, "load_split", lambda *args, **kwargs: records)
+    monkeypatch.setattr(probe.AutoTokenizer, "from_pretrained", lambda *args, **kwargs: tokenizer)
+    monkeypatch.setattr(probe.AutoModelForCausalLM, "from_pretrained", lambda *args, **kwargs: model)
+    monkeypatch.setattr(sys, "argv", [str(SCRIPT), "--device", "cpu", *arguments])
+    probe.main()
+    return tokenizer, model, json.loads(capsys.readouterr().out)
+
