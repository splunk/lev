+    assert binary["ece"] == pytest.approx(0.5)
+    assert binary["mean_conf"] == pytest.approx(0.9)
+    assert ece([], []) == 0.0
+    assert len(binary["reliability_bins"]) == 2
+    low, high = binary["reliability_bins"]
+    assert low == {
+        "lower": 0.1,
+        "upper": 0.2,
