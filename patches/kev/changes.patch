+    ]
+    adapter_configs = [item["adapter_config"] for item in captured]
+    if any(config != adapter_configs[0] for config in adapter_configs[1:]):
+        raise RuntimeError("adapter configuration changed between repeated runs")
+    request_bytes = json.dumps(expected["request"], sort_keys=True, separators=(",", ":")).encode()
+    return {
+        "schema_version": expected["schema_version"],
+        "model_key": expected["model_key"],
+        "model": expected["model"],
+        "request": expected["request"],
+        "fixture_sha256": hashlib.sha256(request_bytes).hexdigest(),
+        "recipe": recipe,
+        "comparison": expected["comparison"],
+        "runtime": {
+            "python": platform.python_version(),
+            "torch": torch.__version__,
+            "transformers": transformers.__version__,
+            "device": torch.cuda.get_device_name(0) if device == "cuda" else "cpu",
+        },
+        "encoded_ids_sha256": hashlib.sha256(json.dumps(encoding["ids"]).encode()).hexdigest(),
+        "adapter_config": adapter_configs[0],
+        "runs": [item["run"] for item in captured],
+    }
+
+
+def _flatten(value):
+    if isinstance(value, (int, float)):
+        return torch.tensor([value], dtype=torch.float64)
+    if isinstance(value, list):
+        pieces = [_flatten(item) for item in value]
+        return torch.cat(pieces) if pieces else torch.empty(0, dtype=torch.float64)
+    raise TypeError(type(value))
+
+
+def _distance(left, right):
+    a, b = _flatten(left), _flatten(right)
+    if a.shape != b.shape:
+        raise AssertionError(f"shape mismatch: {tuple(a.shape)} != {tuple(b.shape)}")
+    return float(torch.max(torch.abs(a - b))) if a.numel() else 0.0
+
+
+def assert_training_matches(expected, actual):
+    for key in (
+        "schema_version", "model_key", "model", "request", "fixture_sha256", "recipe",
+        "comparison", "runtime", "encoded_ids_sha256", "adapter_config",
+    ):
+        assert actual[key] == expected[key], key
+    assert len(expected["runs"]) == 2
+    assert len(actual["runs"]) == 1
+    comparison = expected["comparison"]
+    for field in comparison["fields"]:
+        historical_distance = _distance(expected["runs"][0][field], expected["runs"][1][field])
+        current_distance = _distance(expected["runs"][0][field], actual["runs"][0][field])
+        assert current_distance <= max(historical_distance, comparison["numeric_floor"]), field
+    expected_hashes = [run["final_trainable_sha256"] for run in expected["runs"]]
+    actual_hash = actual["runs"][0]["final_trainable_sha256"]
+    assert all(SHA256.fullmatch(value) is not None for value in [*expected_hashes, actual_hash])
+    assert len(set([*expected_hashes, actual_hash])) == 1
+    for run in [*expected["runs"], *actual["runs"]]:
+        for group in comparison["trainable_groups"]:
+            assert run["gradient_l1"][f"{group}_l1"] > 0
+            assert run["parameter_delta_l2"][f"{group}_l2"] > 0
+            assert run["changed_parameter_tensors"][group] > 0
+        round_trip = run["round_trip"]
+        assert SHA256.fullmatch(round_trip["checkpoint_sha256"]) is not None
+        assert round_trip["evaluation_loss_delta"] <= comparison["round_trip_atol"]
+        assert round_trip["logit_max_abs"] <= comparison["round_trip_atol"]
+        assert round_trip["probability_max_abs"] <= comparison["round_trip_atol"]
+        assert round_trip["passed"] is True
+
+
+def capture_qwen(runs, device):
+    from kev.data import materialize
+    from kev.evaluate import load
+
+    rec = materialize(REQUEST)
+    out = {}
+    for key, identity in MODELS.items():
+        tok, model = load(identity["checkpoint"], device, dtype=torch.bfloat16 if device == "cuda" else torch.float32, merge=False, attn="sdpa" if device == "cuda" else "eager")
+        enc = model.encode(tok, rec, strict=True)
+        vectors = []
+        probability_dtype = None
+        for _ in range(runs):
+            ps = model.probs(enc)
+            probability_dtype = ps[0].dtype
+            vectors.append(torch.cat(ps).tolist())
+        out[key] = {
+            **identity,
+            "encoded_ids": enc["ids"],
+            "execution_mode": "rows" if model.hybrid else "packed",
+            "runtime": runtime(device),
+            "activation_dtype": str(next(model.lm.parameters()).dtype).removeprefix("torch."),
+            **summarize(vectors, probability_dtype),
+        }
+        del model
+        if device == "cuda":
+            torch.cuda.empty_cache()
+    return out
+
+
+def capture_e2b(device):
+    from transformers import AutoModelForCausalLM, AutoTokenizer
+
+    if device != "cuda":
+        raise RuntimeError("the pinned E2B capability capture requires CUDA")
+    torch.cuda.reset_peak_memory_stats()
+    model = AutoModelForCausalLM.from_pretrained(E2B["model"], revision=E2B["revision"], local_files_only=True, dtype=torch.bfloat16, attn_implementation="sdpa").to(device).eval()
+    tok = AutoTokenizer.from_pretrained(E2B["model"], revision=E2B["revision"], local_files_only=True)
+    decoder = model.model.language_model
+    batch = tok("short text-only capability probe", return_tensors="pt").to(device)
+    raw = []
+    with torch.no_grad():
+        for _ in range(3):
+            hidden = decoder(**batch).last_hidden_state
+            raw.append(hidden[0, -1, :8].float().cpu().tolist())
+    suffixes = sorted({name.rsplit(".", 1)[-1] for name, module in decoder.named_modules() if isinstance(module, torch.nn.Linear)})
+    structural = ["<|fim_prefix|>", "<|fim_middle|>", "<|box_start|>", "<|box_end|>", "<|fim_suffix|>"]
+    return {
+        **E2B,
+        "decoder_path": "model.language_model",
+        "decoder_class": type(decoder).__name__,
+        "decoder_model_type": decoder.config.model_type,
+        "hidden_size": decoder.config.hidden_size,
+        "max_position_embeddings": decoder.config.max_position_embeddings,
+        "embedding_class": type(decoder.get_input_embeddings()).__name__,
+        "linear_module_suffixes": suffixes,
+        "accepts_position_ids": True,
+        "padding_side": tok.padding_side,
+        "hidden_shape": list(hidden.shape),
+        "hidden_dtype": str(hidden.dtype).removeprefix("torch."),
+        "hidden_repeatability_samples": raw,
+        "tokenizer_length": len(tok),
+        "structural_token_encodings": {s: tok(s, add_special_tokens=False).input_ids for s in structural},
+        "runtime": runtime(device),
+        "peak_allocated_bytes": torch.cuda.max_memory_allocated(),
+    }
+
+
+def capture_e2b_decision(runs, device):
+    from kev.data import materialize
+    from kev.model import DecisionModel, load_tokenizer
+
+    if device != "cuda": raise RuntimeError("the pinned E2B decision capture requires CUDA")
+    tok = load_tokenizer(E2B["model"], E2B["revision"])
+    model = DecisionModel(E2B["model"], tok, device, lora=2, revision=E2B["revision"], dtype=torch.bfloat16,
+                          attn="sdpa", max_state=512, max_branch=768, max_packed=1024).eval()
+    enc = model.encode(tok, materialize(REQUEST), strict=True)
+    row_vectors = [torch.cat(model.probs(enc)) for _ in range(runs)]
+    row = summarize([v.tolist() for v in row_vectors], row_vectors[0].dtype)
+    model.execution_mode = "packed"
+    try:
+        packed_vectors = [torch.cat(model.probs(enc)) for _ in range(runs)]
+        packed = summarize([v.tolist() for v in packed_vectors], packed_vectors[0].dtype)
+        combined_deviation = max(row["max_deviation"], packed["max_deviation"])
+        atol = max(row["numeric_floor"], 2 * combined_deviation)
+        means_close = torch.allclose(torch.tensor(row["mean"]), torch.tensor(packed["mean"]), rtol=0, atol=atol)
+        packed_status, packed_reason = "supported", None
+    except (TypeError, ValueError, NotImplementedError) as exc:
+        packed, means_close, atol = None, False, row["atol"]
+        packed_status, packed_reason = "unsupported", f"{type(exc).__name__}: {exc}"
+    return {
+        "model": E2B["model"], "revision": E2B["revision"], "runtime": runtime(device),
+        "limits": {"max_state": 512, "max_branch": 768, "max_packed": 1024},
+        "row": row, "packed": packed, "packed_status": packed_status,
+        "packed_reason": packed_reason, "packed_row_parity": means_close,
+        "resolved_mode": "packed" if packed_status == "supported" and means_close else "rows",
+        "atol": atol, "rtol": 0.0,
+    }
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--target", choices=["phase1", "e2b-decision-execution", "qwen-training"], default="phase1")
+    ap.add_argument("--model", choices=sorted(MODELS))
+    ap.add_argument("--runs", type=int, default=3)
+    ap.add_argument("--seed", type=int, default=0)
+    ap.add_argument("--output", type=Path, required=True)
+    ap.add_argument("--update", action="store_true")
+    args = ap.parse_args()
+    if args.output.exists() and not args.update:
+        ap.error(f"refusing to overwrite {args.output} without --update")
+    torch.manual_seed(args.seed)
+    device = "cuda" if torch.cuda.is_available() else "cpu"
+    request_bytes = json.dumps(REQUEST, sort_keys=True, separators=(",", ":")).encode()
+    if args.target == "phase1":
+        payload = {
+            "schema_version": 1, "request": REQUEST, "request_bytes_utf8": request_bytes.decode(),
+            "request_sha256": hashlib.sha256(request_bytes).hexdigest(), "seed": args.seed,
+            "released_qwen": capture_qwen(args.runs, device), "e2b_decoder_capabilities": capture_e2b(device),
+        }
+    elif args.target == "e2b-decision-execution":
+        if not args.output.exists(): ap.error("Phase 1 fixture must exist before E2B decision capture")
+        payload = json.loads(args.output.read_text())
+        payload["e2b_decision_execution"] = capture_e2b_decision(args.runs, device)
+    else:
+        if args.model is None:
+            ap.error("--model is required for qwen-training capture")
+        if args.runs != 2:
+            ap.error("qwen-training capture requires --runs 2")
+        if not args.output.exists():
+            ap.error("the reviewed qwen-training fixture must exist before an intentional refresh")
+        payload = json.loads(args.output.read_text())
+        expected = payload[args.model]["expected"]
+        if device == "cuda":
+            torch.cuda.reset_peak_memory_stats()
+        started = time.time()
+        refreshed = capture_training_case(expected, args.runs, device)
+        payload[args.model] = {
+            "expected": refreshed,
+            "diagnostics": {
+                "historical_commit": subprocess.run(
+                    ["git", "-C", str(Path(__file__).resolve().parents[3]), "rev-parse", "HEAD"],
+                    check=True,
+                    capture_output=True,
+                    text=True,
+                ).stdout.strip(),
+                "baseline_wall_seconds": time.time() - started,
+                "baseline_peak_allocated_bytes": torch.cuda.max_memory_allocated() if device == "cuda" else 0,
+            },
+        }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
+
+
+if __name__ == "__main__":
+    main()
