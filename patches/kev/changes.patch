+    assert [{key: row[key] for key in expected_row} for row in rows] == [expected_row]
+    report = json.loads((out / "report.json").read_text())
+    assert report["clean"]["acc"] == 1.0
+    assert report["clean"]["nll"] == pytest.approx(0.31326166161784674)
+    assert report["clean"]["brier"] == pytest.approx(0.14465897625702673)
