+class NumericTokenizer(FakeTokenizer):
+    def encode(self, text, add_special_tokens=True):
+        match = re.search(r"[0-9]{3,}$", text)
+        prefix = text[:match.start()] if match else text
+        ids = [1000 + ord(char) for char in prefix]
+        if match:
+            ids.append(int(match.group()))
+        return ([3000] if add_special_tokens else []) + ids
+
+    def __call__(self, prompt, **kwargs):
+        self.prompts.append((prompt, kwargs))
+        return Batch(input_ids=torch.tensor([self.encode(
+            prompt, add_special_tokens=kwargs.get("add_special_tokens", True)
+        )]))
+
+    def apply_chat_template(self, messages, **kwargs):
+        self.messages.append((messages, kwargs))
+        return "CHAT\n"
+
+
+class NumericModel(FakeModel):
+    def __init__(self):
+        super().__init__()
+        self.calls = 0
+
+    def __call__(self, **kwargs):
+        self.calls += 1
+        logits = torch.zeros((1, 1, 512))
+        logits[0, 0, 130] = 3.0
+        return SimpleNamespace(logits=logits)
+
+
+def numeric_record(count, record_id="numeric"):
+    request = record(record_id=record_id)
+    request["questions"]["decision"].update(
+        criteria={f"key_{i}": f"Description {i}" for i in range(count)},
+        label="key_129" if count >= 130 else "key_0",
+    )
+    return request
+
+
+@pytest.mark.parametrize("count", [130, 255])
+@pytest.mark.parametrize("mode", ["plain", "chat", "semif"])
+def test_numeric_choices_prompts_probabilities_and_outputs(monkeypatch, capsys, tmp_path, count, mode):
+    data, out = tmp_path / "records.jsonl", tmp_path / "out"
+    request = numeric_record(count)
+    write_jsonl(data, [request])
+    probe, tokenizer, model = load_probe(), NumericTokenizer(), NumericModel()
+    monkeypatch.setattr(probe.AutoTokenizer, "from_pretrained", lambda *a, **kw: tokenizer)
+    monkeypatch.setattr(probe.AutoModelForCausalLM, "from_pretrained", lambda *a, **kw: model)
+    monkeypatch.setattr(sys, "argv", [str(SCRIPT), "--data", str(data), "--out", str(out),
+                                    "--device", "cpu", "--prompt", mode, "--answer-labels", "numbers"])
+
+    probe.main()
+
+    summary = json.loads(capsys.readouterr().out)
+    assert summary["readout"].startswith("zero-shot next-token numeric logits")
+    plain = "Evidence text\nChoose one.\n" + "\n".join(
+        f"{i + 1:03d}. Description {i}" for i in range(count)
+    ) + "\nAnswer: "
+    if mode == "plain":
+        assert tokenizer.prompts == [(plain, {"return_tensors": "pt"})]
+    elif mode == "chat":
+        assert tokenizer.messages == [([{"role": "user", "content": plain}],
+                                      {"tokenize": False, "add_generation_prompt": True})]
+    else:
+        messages, kwargs = tokenizer.messages[0]
+        assert messages[0]["content"] == (
+            "Apply the supplied criterion to the supplied evidence. Choose exactly one listed option. "
+            "Respond with only its number, with no explanation or reasoning."
+        )
+        payload = json.loads(messages[1]["content"])
+        assert payload == {"evidence": "Evidence text", "criterion": "Choose one.", "options": [
+            {"number": f"{i + 1:03d}", "description": f"Description {i}"} for i in range(count)
+        ]}
+        assert kwargs == {"tokenize": False, "add_generation_prompt": True, "enable_thinking": False}
+    if mode != "plain":
+        assert tokenizer.prompts == [("CHAT\n", {"return_tensors": "pt", "add_special_tokens": False})]
+
+    prediction = json.loads((out / "predictions.jsonl").read_text())["prediction"]
+    probabilities = prediction["probabilities"]["decision"]
+    assert list(probabilities) == list(request["questions"]["decision"]["criteria"])
+    expected = torch.softmax(torch.tensor([3.0 if i == 129 else 0.0 for i in range(count)]), -1).tolist()
+    assert list(probabilities.values()) == pytest.approx(expected)
+    assert sum(probabilities.values()) == pytest.approx(1.0)
+    assert max(probabilities, key=probabilities.get) == "key_129"
+    assert model.calls == 1
+    rows = json.loads((out / "rows.json").read_text())
+    assert len(rows) == 1 and rows[0]["label"] == 129
+    assert rows[0]["keys"] == list(probabilities)
+    assert rows[0]["p"] == pytest.approx(expected)
+    report = json.loads((out / "report.json").read_text())
+    assert report["answer_labels"] == "numbers" and report["prompt"] == mode
+    assert report["data_sha256"] == hashlib.sha256(data.read_bytes()).hexdigest()
+    assert report["clean"]["acc"] == 1.0
+    assert report["coverage"] == {
+        "requested_records": 1, "requested_questions": 1,
+        "evaluated_records": 1, "evaluated_questions": 1,
+        "rejected_records": 0, "truncated_records": 0,
+    }
