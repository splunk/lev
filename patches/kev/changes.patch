+                "head": model.head.state_dict(),
+                "base": expected["model"]["base"],
+                "base_revision": expected["model"]["revision"],
+                "lora": recipe["lora_rank"],
+                "head_dim": recipe["head_dim"],
+                "option_isolation": recipe["option_isolation"],
+                "special_embeddings": recipe["special_embeddings"],
+                "weights_dtype": recipe["weights_dtype"],
+                "max_state": recipe["max_state"],
+                "max_branch": recipe["max_branch"],
+                "max_packed": recipe["max_packed"],
+            },
+            checkpoint / "head.pt",
+        )
+        checkpoint_digest = hashlib.sha256()
+        for path in sorted(path for path in checkpoint.rglob("*") if path.is_file()):
+            checkpoint_digest.update(path.relative_to(checkpoint).as_posix().encode())
+            checkpoint_digest.update(path.read_bytes())
