+def test_probability_metric_conventions_preserve_categorical_defaults():
+    from kev.metrics import ece, metrics
+    rows = [
+        {"p": [0.1, 0.9], "label": 1, "type": "noul", "keys": ["false", "true"]},
+        {"p": [0.9, 0.1], "label": 1, "type": "noul", "keys": ["false", "true"]},
+    ]
+
+    default = metrics(rows)
+    explicit = metrics(rows, brier="categorical", ece_target="top-label")
+    binary = metrics(
+        rows,
+        brier="binary",
+        ece_target="positive",
+        include_reliability_bins=True,
+    )
+
+    assert default["brier"] == explicit["brier"] == pytest.approx(0.82)
+    assert default["ece"] == explicit["ece"] == pytest.approx(0.4)
+    assert "reliability_bins" not in default
