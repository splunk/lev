+            str(checkpoint), device, dtype=getattr(torch, recipe["dtype"]), merge=False, attn=recipe["attention"]
+        )
+        reloaded.eval()
+        reloaded_encoding = reloaded.encode(reloaded_tokenizer, record, strict=True)
+        with torch.no_grad():
+            reloaded_loss, reloaded_logits = _training_loss(reloaded, reloaded_encoding, record, device)
+            reloaded_probabilities = [torch.softmax(logit.float(), dim=-1).cpu() for logit in reloaded_logits]
+        logit_max_abs = max(
+            float(torch.max(torch.abs(left - right.detach().float().cpu())))
+            for left, right in zip(in_memory_logits, reloaded_logits)
+        )
+        probability_max_abs = max(
+            float(torch.max(torch.abs(left - right)))
