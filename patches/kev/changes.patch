+@pytest.mark.parametrize("target", ["positive", "top-label"])
+def test_metrics_accepts_zero_weight_rows_in_separate_bins(target):
+    rows = [
+        {"type": "noul", "keys": ["false", "true"], "label": 0, "p": [0.9, 0.1]},
+        {"type": "noul", "keys": ["false", "true"], "label": 1, "p": [0.6, 0.4]},
+    ]
+    result = metrics(rows, weights=[1, 0], brier="binary", ece_target=target,
+                     include_reliability_bins=True)
+    assert result["n"] == 2
+    assert result["weight"] == 1
+    assert result["ece"] == pytest.approx(0.1)
+    assert len(result["reliability_bins"]) == 1
+    assert result["reliability_bins"][0]["count"] == 1
+
