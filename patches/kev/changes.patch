+        "task": "topic",
+        "type": "choice",
+        "variant": "clean",
+        "keys": ["alpha", "beta"],
+        "label": 1,
+        "pair_id": None,
+        "sibling": None,
+        "parent": "r1",
+        "p": pytest.approx([0.2689414322376251, 0.7310585975646973]),
+        "raw_probability_sum": 1.0,
+        "zero_count": 0,
