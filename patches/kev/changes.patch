+def test_suite_plain_prompt_probabilities_rows_and_metrics(monkeypatch, capsys, tmp_path):
+    out = tmp_path / "out"
+    tokenizer, _, summary = run_probe(monkeypatch, capsys, tmp_path, [record()], "--out", str(out))
+
+    assert tokenizer.prompts == [(
+        "Evidence text\nChoose one.\nA. First\nB. Second\nAnswer:",
+        {"return_tensors": "pt"},
+    )]
+    assert summary == {
+        "base": "Qwen/Qwen3-4B-Base",
+        "readout": "zero-shot next-token letter logits",
+        "suite": "evals/v4/transfer-v4",
+        "split": "development",
+        "revision": None,
+        "adapter": None,
+        "sources": {"mmlu": {"n": 1, "acc": 1.0}},
