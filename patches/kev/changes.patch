+def test_probability_metrics_apply_population_weights():
+    from kev.metrics import metrics
+    rows = [
+        {"p": [0.1, 0.9], "label": 1, "type": "noul", "keys": ["false", "true"]},
+        {"p": [0.1, 0.9], "label": 0, "type": "noul", "keys": ["false", "true"]},
+    ]
+
+    unweighted = metrics(rows, brier="binary", ece_target="positive")
+    report = metrics(
