+def test_adapter_embedding_tensors_are_checked_and_loaded():
+    from peft import LoraConfig, get_peft_model, get_peft_model_state_dict, set_peft_model_state_dict
+    from transformers import GraniteConfig, GraniteModel
+    from kev.model import validate_state_dict_compatibility
+
+    model = get_peft_model(GraniteModel(GraniteConfig(vocab_size=8, hidden_size=16, intermediate_size=32,
