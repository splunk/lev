+    },
+}
+SHA256 = re.compile(r"[0-9a-f]{64}")
+
+
+def runtime(device):
+    return {
+        "python": platform.python_version(),
+        "torch": torch.__version__,
+        "transformers": transformers.__version__,
+        "device_class": torch.cuda.get_device_name(0) if device == "cuda" else "cpu",
+        "attention_implementation": "sdpa" if device == "cuda" else "eager",
+    }
+
+
+def summarize(vectors, dtype):
+    values = torch.tensor(vectors, dtype=torch.float64)
+    mean = values.mean(0)
+    max_deviation = (values - mean).abs().max().item()
+    floor = torch.finfo(dtype).eps
+    atol = max(floor, 2 * max_deviation)
+    if atol > 1e-4:
+        raise RuntimeError(f"unstable golden: derived atol {atol} exceeds 1e-4")
+    return {
+        "raw_vectors": vectors,
+        "mean": mean.tolist(),
+        "max_deviation": max_deviation,
+        "numeric_floor": floor,
+        "atol": atol,
+        "rtol": 0.0,
+        "probability_dtype": str(dtype).removeprefix("torch."),
+    }
+
+
+def _tensor_digest(tensor):
+    return hashlib.sha256(tensor.detach().float().cpu().contiguous().numpy().tobytes()).hexdigest()
+
+
+def _normalized_adapter_config(checkpoint):
+    config = json.loads((checkpoint / "adapter_config.json").read_text())
+    if config.get("target_modules") is not None:
+        config["target_modules"] = sorted(config["target_modules"])
+    return config
+
+
+def _snapshot_trainable(model):
+    return {name: value.detach().cpu().clone() for name, value in model.named_parameters() if value.requires_grad}
+
+
+def _restore_trainable(model, state):
+    named = dict(model.named_parameters())
+    for name, value in state.items():
+        named[name].data.copy_(value.to(named[name].device, dtype=named[name].dtype))
+
+
+def _parameter_group(name, selectors):
+    matches = []
+    for group, selector in selectors.items():
+        if selector["match"] == "prefix":
+            matched = name.startswith(selector["value"])
+        elif selector["match"] == "contains":
+            matched = selector["value"] in name
+        else:
+            raise ValueError(f"unsupported trainable-group matcher: {selector['match']}")
+        if matched:
+            matches.append(group)
+    if len(matches) > 1:
+        raise ValueError(f"parameter {name!r} matches multiple trainable groups: {matches}")
+    return matches[0] if matches else None
+
+
+def _training_loss(model, encoding, record, device):
+    logits = model(encoding)
+    losses = [
+        torch.nn.functional.cross_entropy(logit.float()[None], torch.tensor([question["label"]], device=device))
+        for logit, question in zip(logits, record["questions"])
+    ]
+    return sum(losses) / len(losses), logits
+
+
+def _capture_training_run(model, tokenizer, expected, encoding, record, initial, device):
+    from kev.evaluate import load
