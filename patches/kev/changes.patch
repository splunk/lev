+        raise ValueError("training-regression optimizer_steps must be positive")
+    optimizer = torch.optim.AdamW(
+        model.trainable_parameters(),
+        lr=recipe["learning_rate"],
+        weight_decay=recipe["weight_decay"],
+    )
+    before = _snapshot_trainable(model)
+    unmatched = [name for name in before if _parameter_group(name, selectors) is None]
