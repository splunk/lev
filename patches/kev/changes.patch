+    source = {key: value.detach().clone().fill_(0.25) for key, value in target.items()}
+    embedding_keys = set(target) - set(get_peft_model_state_dict(model, save_embedding_layers=False))
+    assert embedding_keys
+    validate_state_dict_compatibility(source, target, label="adapter")
+    set_peft_model_state_dict(model, source)
