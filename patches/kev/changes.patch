+def test_numeric_token_failures_precede_model_loading(monkeypatch, tmp_path, mode, failure):
+    data, out = tmp_path / "records.jsonl", tmp_path / "out"
+    write_jsonl(data, [numeric_record(130, "good"), numeric_record(130, "bad")])
+    probe, tokenizer, loaded = load_probe(), NumericTokenizer(), []
+    original_encode = tokenizer.encode
+    appended = 0
+
+    def encode(text, **kwargs):
+        nonlocal appended
+        ids = original_encode(text, **kwargs)
+        if re.search(r"[0-9]{3,}$", text):
+            appended += 1
+            # Let the entire first record pass, then fail on the second record.
+            if appended > 130:
+                if failure == "collision":
+                    return ids[:-1] + [1]
+                if failure == "multi":
+                    return ids + [2]
+                return [42] + ids[1:]
+        return ids
+
+    tokenizer.encode = encode
+    monkeypatch.setattr(probe.AutoTokenizer, "from_pretrained", lambda *a, **kw: tokenizer)
+    monkeypatch.setattr(probe.AutoModelForCausalLM, "from_pretrained", lambda *a, **kw: loaded.append(True))
+    monkeypatch.setattr(sys, "argv", [str(SCRIPT), "--data", str(data), "--out", str(out),
+                                    "--device", "cpu", "--prompt", mode, "--answer-labels", "numbers"])
+    with pytest.raises(ValueError, match=r"records\.jsonl.*bad.*decision.*answer-slot"):
+        probe.main()
+    assert loaded == [] and not out.exists()
