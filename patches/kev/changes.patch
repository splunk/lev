+    for invalid in ({**source, "extra": torch.zeros(1)}, {}):
+        with pytest.raises(ValueError, match="keys differ"):
+            validate_state_dict_compatibility(invalid, target, label="adapter")
+    key = next(iter(embedding_keys))
+    with pytest.raises(ValueError, match="keys differ"):
+        validate_state_dict_compatibility(source, {name: value for name, value in target.items() if name != key}, label="adapter")
