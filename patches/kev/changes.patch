+
+    deltas = {f"{group}_l2": 0.0 for group in selectors}
+    changed = {group: 0 for group in selectors}
+    for name, parameter in model.named_parameters():
+        if name not in before:
+            continue
+        group = _parameter_group(name, selectors)
+        difference = parameter.detach().float().cpu() - before[name].float()
+        deltas[f"{group}_l2"] += float(torch.sum(difference * difference))
+        changed[group] += int(torch.count_nonzero(difference) > 0)
+    deltas = {name: value**0.5 for name, value in deltas.items()}
+
+    model.eval()
+    with torch.no_grad():
+        evaluation_loss, logits = _training_loss(model, encoding, record, device)
