+    assert report["ece"] == pytest.approx(0.0)
+    assert report["acc"] == unweighted["acc"] == pytest.approx(0.5)
+    assert report["selective"] == unweighted["selective"]
+    assert report["aurc"] == unweighted["aurc"]
+    assert report["weight"] == pytest.approx(10.0)
