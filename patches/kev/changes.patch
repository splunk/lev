+REQUEST = {
+    "state": "Service api-7 emitted three timeout warnings after a deployment. Host db-2 remained healthy.",
+    "questions": {
+        "anomaly": {"type": "noul", "instructions": "Does this state describe anomalous service behavior?", "label": True, "src": "golden"},
