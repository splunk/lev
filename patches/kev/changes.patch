diff --git a/tests/test_backbone_compatibility.py b/tests/test_backbone_compatibility.py
new file mode 100644
index 0000000000000000000000000000000000000000..c0ddc9d4c5248785317f4bf63e356094bbf79972
--- /dev/null
+++ b/tests/test_backbone_compatibility.py
@@ -0,0 +1,381 @@
+import types
+
+import pytest
+import torch
+from torch import nn
+
+
+class FakeDecoder(nn.Module):
+    def __init__(self, model_type="qwen3", width=16):
+        super().__init__()
+        self.config = types.SimpleNamespace(model_type=model_type, hidden_size=width, layer_types=[])
+        self.embed_tokens = nn.Embedding(32, width)
+
+    def get_input_embeddings(self):
+        return self.embed_tokens
+
+    def forward(self, input_ids=None, attention_mask=None, position_ids=None, **kwargs):
+        return types.SimpleNamespace(last_hidden_state=self.embed_tokens(input_ids))
+
+
+class Wrapper(nn.Module):
+    def __init__(self, decoder, gemma=False):
+        super().__init__()
+        self.config = types.SimpleNamespace(model_type="gemma4" if gemma else decoder.config.model_type)
+        if gemma:
+            self.model = nn.Module()
+            self.model.language_model = decoder
+        else:
+            self.model = decoder
+
+
+class FakeTokenizer:
+    def __init__(self, pieces):
+        self.vocab = {token: i for i, token in enumerate(pieces)}
+        self.unk_token_id = -1
+
+    def __len__(self): return len(self.vocab)
+    def __call__(self, text, add_special_tokens=False):
+        ids = [self.vocab[text]] if text in self.vocab else [900, 901]
+        return types.SimpleNamespace(input_ids=ids)
+    def convert_tokens_to_ids(self, token): return self.vocab.get(token, self.unk_token_id)
+    def add_special_tokens(self, values):
+        before = len(self.vocab)
+        for token in values["additional_special_tokens"]:
+            if token not in self.vocab: self.vocab[token] = len(self.vocab)
+        return len(self.vocab) - before
+
+
+class ResizableWrapper(Wrapper):
+    def __init__(self, decoder, vocab):
+        super().__init__(decoder)
+        decoder.embed_tokens = nn.Embedding(vocab, decoder.config.hidden_size)
+        self.resize_calls = []
+    def get_input_embeddings(self): return self.model.get_input_embeddings()
+    def resize_token_embeddings(self, size, mean_resizing=True):
+        self.resize_calls.append(size)
+        self.model.embed_tokens = nn.Embedding(size, self.model.config.hidden_size)
+        return self.model.embed_tokens
+
+
+class PerLayerResizableWrapper(ResizableWrapper):
+    def __init__(self, decoder, vocab):
+        super().__init__(decoder, vocab)
+        self.model.embed_tokens_per_layer = nn.Embedding(vocab, 3 * decoder.config.hidden_size)
+    def get_per_layer_input_embeddings(self): return self.model.embed_tokens_per_layer
+    def resize_token_embeddings(self, size, mean_resizing=True):
+        super().resize_token_embeddings(size, mean_resizing=mean_resizing)
+        self.model.embed_tokens_per_layer = nn.Embedding(size, 3 * self.model.config.hidden_size)
+        return self.model.embed_tokens
