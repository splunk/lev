+        "pointer_head": sum(float(p.grad.float().abs().sum()) for n, p in named if n.startswith("head.") and p.grad is not None),
+    }
+    assert all(value > 0 for value in grad_sums.values()), grad_sums
+    before_parameters = {n: p.detach().float().cpu().clone() for n, p in named if p.requires_grad}
+    optimizer.step()
+    assert any(not torch.equal(before_parameters[n], p.detach().float().cpu()) for n, p in model.named_parameters() if n in before_parameters)
